# Chapter 30: generated by scanning this repo's own source plus the
# installed reliable_agents_labs dependency for every real
# os.environ[...] / os.environ.get(...) reference, then curated by
# hand, since the raw scan finds every variable the shared dependency
# can ever read, not every variable this specific product needs.
# Re-run `uv run python scripts/check_env_example.py` after adding a
# new environment variable anywhere in this repo to check this file
# is still complete.

# Required: this product's own real Postgres connection (see compose.yaml)
DATABASE_URL=postgresql://triage_app:triage_app@localhost:5435/triage_app

# Required: config/models.yaml points "answer_model" at Gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash

# Required: this product's own Auth0 API resource (chapter 22)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://triage-app.dev/api

# Optional: only needed to run tests/contract/test_auth_live.py
# (skipped automatically if unset)
# AUTH0_TEST_CLIENT_ID=
# AUTH0_TEST_CLIENT_SECRET=

# Optional: defaults to http://localhost:5175 if unset
# FRONTEND_ORIGIN=http://localhost:5175

# NOT used by this product: ANTHROPIC_API_KEY, ANTHROPIC_MODEL_ID,
# API_KEY, NEO4J_URI, NEO4J_PASSWORD are all real variables
# reliable_agents_labs can read for other products' own features
# (a secondary model provider, package-dependency graph storage),
# neither of which triage-app's own code path ever touches. A raw
# automated scan finds them anyway; leaving them out of this file is
# a deliberate, human judgment call, not an oversight.
